# ==============================================================================
# UserHQ Environment Configuration Template (.env.example)
#
# Copy this file to:
#   - .env (for local native development)
#   - .env.docker (for local Docker smoke testing)
#   - Dokploy environment settings (for staging and production)
#
# NOTE: Never commit real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Compose / Dokploy Production & Staging
# ------------------------------------------------------------------------------
# PostgreSQL database credentials
POSTGRES_USER=userhq
POSTGRES_PASSWORD=replace_with_hex
POSTGRES_DB=userhq

# Canonical public origin for auth callbacks and session cookies
# Must include protocol (https:// in prod/staging) without trailing slash
PUBLIC_URL=https://userhq.test

# Better Auth secret key (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=replace_with_64_hex

# Google OAuth 2.0 Credentials (Authorized redirect: ${PUBLIC_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_secret

# GitHub OAuth App Credentials (Authorized redirect: ${PUBLIC_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_secret

# The verified Google/GitHub email of the platform owner; it is the only way to get the /platform console; required.
PLATFORM_OWNER_EMAIL=owner@example.com

# ------------------------------------------------------------------------------
# 2. Native Development (.env loaded by `bun run dev` in apps/api)
# ------------------------------------------------------------------------------
# Connects to the local PostgreSQL container running on 127.0.0.1:5432
DATABASE_URL=postgres://userhq:userhq@127.0.0.1:5432/userhq_dev
# Local web server port and base URL
PORT=4000
# Development upload directory on the host filesystem
UPLOAD_DIR=./.data/uploads

# ------------------------------------------------------------------------------
# 3. Local Docker Smoke Testing (.env.docker)
# ------------------------------------------------------------------------------
# When running full compose stack locally on port 8080:
# PUBLIC_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. Automated Tests
# ------------------------------------------------------------------------------
# Connection string with superuser/admin privileges used to create/drop
# isolated temporary databases during test suite execution (e.g. vitest).
TEST_DATABASE_ADMIN_URL=postgres://userhq:userhq@127.0.0.1:5432/postgres
