{
  "name": "userhq",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-server-dom-webpack": "19.3.0",
      "zod": "4.6.5",
      "typescript": "6.0.3"
    }
  },
  "scripts": {
    "lint": "oxlint -c .oxlintrc.json",
    "test:lint-rules": "node --test tools/lint-rules.test.mjs",
    "build:packages": "bun run --filter '@userhq/types' build && bun run --filter '@userhq/db' build",
    "build": "bun run build:packages && bun run --filter '@userhq/api' build && bun run --filter '@userhq/web' build",
    "typecheck": "bun run --filter '@userhq/*' typecheck",
    "test": "bun run test:lint-rules && bun run --filter '@userhq/db' test && bun run --filter '@userhq/api' test && bun run --filter '@userhq/web' test",
    "format": "prettier --write .",
    "stack:up": "docker compose -f compose.yaml -f compose.local.yaml --env-file .env.docker up -d --build --wait",
    "stack:down": "docker compose -f compose.yaml -f compose.local.yaml --env-file .env.docker down"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
