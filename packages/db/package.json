{
  "name": "@userhq/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "auth": "1.7.7",
    "better-auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/migrate.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node dist/migrate.js"
  }
}
