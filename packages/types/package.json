{
  "name": "@userhq/types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts && cp dist/index.mjs dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
